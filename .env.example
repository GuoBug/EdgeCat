# Copy this file to .env before running `docker compose up -d`
# Generate a strong random token via: openssl rand -hex 16 (prefix with ec-)

TZ=Asia/Shanghai
EDGECAT_PORT=8080

# Required: Bearer token distributed to your LAN devices (Chatbox / Cherry Studio / PatchCat)
EDGECAT_CLIENT_TOKEN=ec-change-me-to-a-random-32-hex-token

# Local Ollama / vLLM endpoint (host.docker.internal reaches Ollama running on the NAS/host)
EDGECAT_LOCAL_ENDPOINT=http://host.docker.internal:11434/v1

# Optional: Cloud fallback endpoint & master API key (locked safely on the NAS/host)
EDGECAT_CLOUD_ENDPOINT=https://api.openai.com/v1
EDGECAT_CLOUD_API_KEY=
